{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "arduino: compile",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn", "esp8266:esp8266:generic:eesz=1M64",
        "--build-path", "${workspaceFolder}/.build",
        "${workspaceFolder}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "arduino: upload (COM3)",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "upload",
        "-p", "COM3",
        "--fqbn", "esp8266:esp8266:generic:eesz=1M64",
        "--input-dir", "${workspaceFolder}/.build",
        "${workspaceFolder}"
      ],
      "dependsOn": "arduino: compile",
      "problemMatcher": []
    },
    {
      "label": "arduino: serial monitor @115200 (COM3)",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "monitor",
        "-p", "COM3",
        "--config", "baudrate=115200"
      ],
      "problemMatcher": []
    },
    {
      "label": "arduino: list boards (detect port)",
      "type": "shell",
      "command": "arduino-cli",
      "args": ["board", "list"],
      "problemMatcher": []
    }
  ]
}
